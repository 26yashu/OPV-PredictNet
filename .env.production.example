# ==============================================================================
# OPV-PredictNet — Production Deployment Environment Template (.env.production.example)
#
# Production Guidelines:
# 1. Set ENVIRONMENT=production and DEBUG=False.
# 2. Generate a secure 32+ character JWT_SECRET_KEY (`openssl rand -hex 32`).
# 3. Restrict CORS_ORIGINS strictly to the production frontend domain(s).
# 4. Use a persistent, backed-up database volume or hosted PostgreSQL instance.
# ==============================================================================

ENVIRONMENT=production
DEBUG=False
APP_NAME="OPV-PredictNet Backend"
APP_VERSION="0.1.0"

# Server Network Binding
API_HOST=0.0.0.0
API_PORT=8000

# CORS Allowed Origins (Set to your exact production domain)
CORS_ORIGINS=["https://opv-predictnet.your-institution.edu"]
FRONTEND_URL=https://opv-predictnet.your-institution.edu

# Database Configuration (Persistent path or PostgreSQL)
# SQLite example with persistent volume: sqlite:////app/data/opv_predictnet.db
# PostgreSQL example: postgresql+psycopg2://opv_user:SECURE_PASSWORD@db:5432/opv_predictnet
DATABASE_URL=sqlite:////app/data/opv_predictnet.db

# Authentication Security
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Model Serving & Artifacts
MODEL_DIRECTORY=ml/models/saved_models/phase9_v1
DEFAULT_MODEL_VERSION=phase9_v1

# Scientific Governance (Non-negotiable)
RESEARCH_ESTIMATE_ONLY=True
VALIDATED_FOR_PRODUCTION=False
