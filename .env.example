# ==============================================================================
# OPV-PredictNet Environment Configuration Template
# Copy this file to .env and configure local values before running the application.
# NEVER commit the active .env file or real production credentials to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="OPV-PredictNet Backend"
APP_VERSION="0.1.0"

# Server Network Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Database Configuration (SQLite for Phase 1 local development)
DATABASE_URL=sqlite:///./opv_predictnet.db

# Security & Authentication (Argon2 + JWT)
# Generate a secure key in production (e.g., using `openssl rand -hex 32`)
JWT_SECRET_KEY=change-this-insecure-secret-key-in-production-min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Configuration (JSON array of allowed frontend origins)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ML & Model Serving
MODEL_DIRECTORY=ml/models/saved_models
DEFAULT_MODEL_VERSION=v1.0.0

# Local Chatbot Configuration (Rule / Knowledge-base driven, zero paid external APIs)
CHATBOT_KNOWLEDGE_BASE_PATH=docs/scientific_basis
CHATBOT_MAX_CONTEXT_TOKENS=1024
