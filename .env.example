# ==============================================================================
# OPV-PredictNet — Local Development Environment Configuration (.env.example)
#
# Instructions:
# 1. Copy this file to `.env`:
#      PowerShell: Copy-Item .env.example .env
#      Bash:       cp .env.example .env
# 2. Adjust local ports or database paths if necessary.
# 3. NEVER commit `.env` containing sensitive credentials to version control.
# ==============================================================================

# Application Environment (development | production | testing)
ENVIRONMENT=development
DEBUG=True
APP_NAME="OPV-PredictNet Backend"
APP_VERSION="0.1.0"

# Server Network Binding
API_HOST=0.0.0.0
API_PORT=8000

# CORS Allowed Origins
# Supports comma-separated strings or JSON arrays
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
FRONTEND_URL=http://localhost:5173

# Database Configuration (SQLite for local demo / development)
# For production PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/opv_db
DATABASE_URL=sqlite:///./opv_predictnet.db

# Authentication & Security (Argon2id + JWT)
# For production, generate a cryptographically strong secret (e.g., `openssl rand -hex 32`)
JWT_SECRET_KEY=change-this-insecure-secret-key-in-production-min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Model Serving & Artifacts
MODEL_DIRECTORY=ml/models/saved_models/phase9_v1
DEFAULT_MODEL_VERSION=phase9_v1

# Scientific Governance (Enforced constants across all deployment tiers)
RESEARCH_ESTIMATE_ONLY=True
VALIDATED_FOR_PRODUCTION=False
